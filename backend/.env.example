# Copy this file to ".env" and fill in your values.

# Server
PORT=4000
AUTH_SECRET=change-this-to-a-long-random-secret

# Optional comma-separated allowed frontend origins for CORS (e.g. your Vercel URL)
# Leave blank to allow all origins during testing
CORS_ORIGIN=

# Supabase (recommended for Render so data persists across restarts)
# Get these from your Supabase project: Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Crawler limits (safe defaults)
MAX_PAGES=25
MAX_DEPTH=2
REQUEST_TIMEOUT_MS=4500
